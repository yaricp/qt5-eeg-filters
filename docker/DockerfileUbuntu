FROM ubuntu:24.04

RUN apt update && apt upgrade -y
RUN apt install -y curl python3.12 python3-poetry python3-pyqt5 bash qt5-qmake

COPY ./pyproject.toml /
COPY ./docker/start.sh /

WORKDIR /

RUN poetry lock
RUN poetry install --no-root

COPY ./src /app

ENTRYPOINT ["/usr/bin/bash", "-c"]

CMD ["./start.sh"]
